# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:glJpcM7BYwWiBggp3SQ/+NlRkqsBQMaGEOjemXqJzOU=
APP_URL=http://localhost:8000
APP_TIMEZONE='UTC'
APP_LOCALE='en-US'

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
# PHPUnit, PhpStorm, and plain `php artisan test` default to SQLite via
# phpunit.xml. SQLite uses database/database.sqlite and needs no MySQL service.
# Use `php artisan test --parallel` for Laravel's native parallel runner.
# `composer test:split` runs SQLite, then MySQL-sensitive tests, stopping on
# the first failure. `composer test:mysql` runs all MySQL-compatible tests.
# Configure an existing, dedicated MySQL test database below for those commands.
# Composer overrides DB_CONNECTION; no second .env file or separate SQLite
# credentials are needed. An explicit shell DB_CONNECTION takes precedence
# over phpunit.xml's default.
# Parallel MySQL workers create/drop databases named <DB_DATABASE>_test_<N>,
# so the test user needs permission to manage those databases as well.
# The mysql and mysqldump clients on PATH enable faster snapshot resets;
# otherwise MySQL tests fall back to running migrations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snipe_test
DB_USERNAME=null
DB_PASSWORD=null

# --------------------------------------------
# TEST-SUITE MEMORY CEILING
# --------------------------------------------
# ItemImportRequest, ObjectImportCommand, and LdapSync each call
# ini_set('memory_limit', env('IMPORT_MEMORY_LIMIT', '500M')) at
# request-boot / command-boot time. That downgrades whatever the
# CLI sets (via -d memory_limit=1G or php.ini), so a full-suite
# run that hits any importer fixture crashes at ~500M even when
# the CLI asked for more. Bumping the override here means the
# tests inherit a workable ceiling without changing the production
# defaults those same env keys use on real installs.
IMPORT_MEMORY_LIMIT=2G
LDAP_MEM_LIM=2G
