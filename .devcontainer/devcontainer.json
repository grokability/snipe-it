{
  "name": "Snipe-IT Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace/snipe-it",
  "postCreateCommand": "composer install",
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "DEVSENSE.phptools-vscode",
        "laravel.vscode-laravel"
      ]
    }
  }
}
